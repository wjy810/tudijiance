{
  "name": "tudijiance-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "小麦品种实验田数字化管理系统 桌面端",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "electron": "electron .",
    "dist:win": "pnpm build && node scripts/dist-win.mjs",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "dev:offline": "vite --config vite.mobile.config.ts --mode offline",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:offline": "vite build --config vite.mobile.config.ts --mode offline",
    "android:sync": "pnpm build:mobile && cap sync android",
    "android:apk": "node scripts/build-android.mjs",
    "android:offline": "node scripts/build-android.mjs --offline"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "axios": "^1.21.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dexie": "4.4.7",
    "echarts": "^6.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "element-plus": "^2.14.7",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.0.1",
    "konva": "^10.9.0",
    "npm-run-all2": "^9.0.3",
    "pinia": "^4.0.3",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "resedit": "3.1.0",
    "typescript": "~6.0.0",
    "vant": "4.10.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-konva": "^4.0.1",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11",
    "wait-on": "^9.0.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "build": {
    "appId": "cn.tudijiance.desktop",
    "productName": "小麦实验田管理",
    "copyright": "小麦品种实验田数字化管理系统",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "afterPack": "electron/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "shortcutName": "小麦实验田管理",
      "artifactName": "tudijiance-desktop-setup-${version}.exe"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "publish": null
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "vue-demi"
    ]
  }
}
